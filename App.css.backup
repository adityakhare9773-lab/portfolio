
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #f4f4f5;
  background: #09090b;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  scroll-behavior: smooth;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-width: 320px;
  min-height: 100vh;
  background: #09090b;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

.portfolio {
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 80% 10%, #17142b 0%, transparent 35%),
    #09090b;
}

/* NAVIGATION */

.navbar {
  max-width: 1240px;
  margin: auto;
  padding: 28px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid #242429;
}

.logo {
  flex-shrink: 0;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 30px;
  font-weight: 700;
  color: #f4f4f5;
}

.logo span {
  color: #a78bfa;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 32px;
  color: #b4b4c0;
  font-size: 14px;
}

.nav-links a {
  transition: color 0.2s ease;
}

.nav-links a:hover {
  color: #c4b5fd;
}

.nav-button,
.secondary-button {
  display: inline-block;
  border: 1px solid #3f3f46;
  border-radius: 9px;
  padding: 14px 20px;
  color: #f4f4f5;
  font-size: 14px;
  transition: border-color 0.2s ease, background 0.2s ease;
}

.nav-button:hover,
.secondary-button:hover {
  border-color: #a78bfa;
  background: #171420;
}

/* HERO SECTION */

.hero {
  max-width: 1240px;
  min-height: 660px;
  padding: 90px 6%;
  margin: auto;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 55px;
}

.availability {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 12px 16px;
  border: 1px solid #303036;
  border-radius: 30px;
  color: #e4e4e7;
  font-size: 12px;
  letter-spacing: 1px;
  margin-bottom: 30px;
}

.status-dot {
  width: 7px;
  height: 7px;
  flex-shrink: 0;
  background: #a78bfa;
  border-radius: 50%;
}

.eyebrow,
.section-label {
  color: #b4b4c0;
  font-size: 12px;
  letter-spacing: 2px;
  margin-bottom: 20px;
}

/* Main headings: keep them readable on the dark background */

.hero h1,
.about h2,
.contact h2 {
  font-family: 'Space Grotesk', sans-serif;
  color: #f4f0ff;
  font-size: clamp(42px, 5.5vw, 76px);
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -2px;
  overflow-wrap: anywhere;
}

.hero h1 span,
.about h2 span,
.contact h2 span {
  color: #a78bfa;
}

.hero-description {
  max-width: 540px;
  color: #b4b4c0;
  font-size: 16px;
  line-height: 1.9;
  margin-top: 25px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 32px;
}

.primary-button {
  display: inline-block;
  background: #a78bfa;
  color: #171020;
  padding: 15px 22px;
  border: 1px solid #a78bfa;
  border-radius: 9px;
  font-size: 14px;
  font-weight: 700;
  transition: transform 0.2s ease, background 0.2s ease;
}

.primary-button:hover {
  background: #c4b5fd;
  transform: translateY(-2px);
}

.secondary-button {
  padding: 15px 22px;
}

.hero-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 55px;
  color: #a1a1aa;
  font-size: 10px;
  letter-spacing: 1px;
}

/* HERO VISUAL CARD */

.hero-visual {
  min-width: 0;
  min-height: 430px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.orbit {
  position: absolute;
  border: 1px solid #29253b;
  border-radius: 50%;
  width: 410px;
  height: 410px;
  max-width: 100%;
}

.orbit-two {
  width: 340px;
  height: 340px;
  border-color: #353047;
}

.visual-card {
  position: relative;
  z-index: 1;
  width: min(100%, 350px);
  padding: 30px;
  background: linear-gradient(145deg, #191821, #101014);
  border: 1px solid #383444;
  border-radius: 18px;
  box-shadow: 0 30px 100px #0008;
}

.card-label,
.project-number {
  font-size: 11px;
  color: #b9a4ff;
  letter-spacing: 2px;
}

.code-icon {
  width: 65px;
  height: 65px;
  display: grid;
  place-items: center;
  margin: 30px 0 25px;
  color: #c4b5fd;
  background: #28213c;
  border: 1px solid #45375f;
  border-radius: 15px;
  font-size: 26px;
}

.visual-card h2 {
  font-family: 'Space Grotesk', sans-serif;
  color: #f4f0ff;
  font-size: 25px;
}

.muted-heading {
  color: #aaa6b7;
  margin-top: 5px;
}

.card-divider {
  height: 1px;
  background: #34313c;
  margin: 25px 0 12px;
}

.focus-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #27252d;
  color: #c0becb;
  font-size: 10px;
}

.floating-tag {
  position: absolute;
  z-index: 2;
  padding: 14px 16px;
  background: #1b1924;
  border: 1px solid #423853;
  border-radius: 9px;
  font-size: 12px;
  color: #e4dcff;
  box-shadow: 0 10px 35px #0008;
}

.tag-top {
  top: 55px;
  right: 0;
}

.tag-bottom {
  bottom: 50px;
  left: 0;
}

/* GENERAL SECTIONS */

.section {
  max-width: 1120px;
  margin: auto;
  padding: 100px 6%;
  border-top: 1px solid #242429;
}

.section h2 {
  font-family: 'Space Grotesk', sans-serif;
  color: #f4f0ff;
  font-size: clamp(32px, 4vw, 48px);
  line-height: 1.2;
  letter-spacing: -1.5px;
  margin-bottom: 25px;
}

.about > p:last-child,
.contact > p:not(.section-label) {
  max-width: 700px;
  color: #b4b4c0;
  line-height: 1.9;
  font-size: 16px;
}

/* SKILLS */

.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.skill-list span {
  padding: 15px 20px;
  background: #151518;
  border: 1px solid #303036;
  border-radius: 9px;
  color: #e4e4e7;
  font-size: 14px;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.skill-list span:hover {
  border-color: #8b5cf6;
  transform: translateY(-2px);
}

/* PROJECTS */

.project-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.project-card {
  min-width: 0;
  padding: 30px;
  border: 1px solid #303036;
  border-radius: 14px;
  background: linear-gradient(145deg, #151518, #101012);
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.project-card:hover {
  border-color: #8b5cf6;
  transform: translateY(-4px);
}

.project-card h3 {
  font-family: 'Space Grotesk', sans-serif;
  color: #f4f0ff;
  font-size: 23px;
  line-height: 1.4;
  margin: 24px 0 15px;
}

.project-card p {
  color: #b4b4c0;
  line-height: 1.8;
  font-size: 14px;
  margin-bottom: 24px;
}

.project-tech {
  color: #c4b5fd;
  font-size: 12px;
  line-height: 1.8;
}

.project-note {
  color: #a1a1aa;
  font-size: 12px;
  line-height: 1.7;
  margin-top: 18px;
}

/* CONTACT */

.contact > p:not(.section-label) {
  margin-bottom: 28px;
}

.contact .hero-buttons {
  margin-bottom: 35px;
}

/* FOOTER */

.footer {
  border-top: 1px solid #242429;
  padding: 28px 6%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  color: #a1a1aa;
  font-size: 12px;
}

.footer .logo {
  color: #f4f4f5;
}

/* TABLETS */

@media (max-width: 800px) {
  .navbar {
    padding: 24px 5%;
  }

  .hero {
    grid-template-columns: 1fr;
    padding-top: 65px;
    gap: 25px;
  }

  .hero-content {
    min-width: 0;
  }

  .hero-visual {
    min-height: 430px;
  }

  .nav-links {
    gap: 16px;
  }

  .nav-button {
    display: none;
  }

  .section {
    padding-top: 80px;
    padding-bottom: 80px;
  }
}

/* MOBILE PHONES */

@media (max-width: 520px) {
  .navbar {
    padding: 20px 5%;
    flex-wrap: wrap;
    gap: 18px;
  }

  .logo {
    font-size: 25px;
  }

  .nav-links {
    gap: 12px;
    font-size: 11px;
  }

  .hero {
    min-height: auto;
    padding: 55px 6%;
  }

  .hero h1 {
    font-size: clamp(38px, 10vw, 52px);
    letter-spacing: -1.5px;
  }

  .hero-description {
    font-size: 15px;
  }

  .hero-buttons {
    gap: 10px;
  }

  .primary-button,
  .secondary-button {
    padding: 13px 15px;
    font-size: 13px;
  }

  .hero-footer {
    gap: 12px;
    margin-top: 35px;
  }

  .hero-visual {
    min-height: 360px;
  }

  .orbit {
    width: 320px;
    height: 320px;
  }

  .orbit-two {
    width: 260px;
    height: 260px;
  }

  .visual-card {
    padding: 24px;
  }

  .tag-top {
    top: 15px;
  }

  .tag-bottom {
    bottom: 15px;
  }

  .section {
    padding: 65px 6%;
  }

  .section h2 {
    font-size: clamp(30px, 8vw, 40px);
    letter-spacing: -1px;
  }

  .about > p:last-child,
  .contact > p:not(.section-label) {
    font-size: 15px;
  }

  .skill-list span {
    padding: 12px 14px;
    font-size: 13px;
  }

  .project-grid {
    grid-template-columns: 1fr;
  }

  .project-card {
    padding: 24px;
  }

  .project-card h3 {
    font-size: 21px;
  }

  .footer {
    flex-wrap: wrap;
    padding: 25px 6%;
  }
}

/* ACCESSIBILITY */

a:focus-visible,
button:focus-visible {
  outline: 2px solid #c4b5fd;
  outline-offset: 4px;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

.project-link {
  display: inline-block;
  margin-top: 12px;
  padding: 10px 16px;
  border: 1px solid #a78bfa;
  border-radius: 8px;
  color: #c4b5fd;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.2s ease;
}

.project-link:hover {
  background: #8b5cf6;
  color: #ffffff;
  transform: translateY(-2px);
}

.profile-card {
  text-align: center;
}

.profile-card .profile-photo {
  display: block;
  width: 120px !important;
  height: 120px !important;
  max-width: 120px !important;
  object-fit: cover;
  object-position: center 25%;
  border-radius: 50%;
  border: 3px solid #a78bfa;
  margin: 0 auto 24px;
}

@media (max-width: 600px) {
  .profile-card .profile-photo {
    width: 100px !important;
    height: 100px !important;
    max-width: 100px !important;
  }
}

/* ==============================
   SMOOTH PORTFOLIO ANIMATIONS
   ============================== */

/* Smooth scrolling */
html {
  scroll-behavior: smooth;
}

/* Smooth transitions for interactive elements */
a,
button,
.project-card,
.skill-card,
.visual-card {
  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease,
    color 0.3s ease,
    background-color 0.3s ease;
}

/* Hover effect for project cards */
.project-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 35px rgba(139, 92, 246, 0.18);
  border-color: #a78bfa;
}

/* Hover effect for skill cards */
.skill-card:hover {
  transform: translateY(-5px);
  border-color: #a78bfa;
  box-shadow: 0 8px 25px rgba(139, 92, 246, 0.15);
}

/* Hover effect for your profile card */
.visual-card:hover {
  transform: translateY(-5px);
  border-color: #a78bfa;
}

/* Hover effect for links */
a:hover {
  color: #c4b5fd;
}

/* Buttons lift slightly when hovered */
button:hover {
  transform: translateY(-2px);
}

/* Profile photo zooms in slightly */
.profile-photo {
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.profile-photo:hover {
  transform: scale(1.06);
  box-shadow: 0 0 25px rgba(167, 139, 250, 0.45);
}

/* Respect users who prefer reduced motion */
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* Fade-in animation for sections */
.fade-in-section {
  opacity: 0;
  transform: translateY(25px);
  transition: opacity 0.8s ease, transform 0.8s ease;
}

.fade-in-section.visible {
  opacity: 1;
  transform: translateY(0);
}

/* Accessibility: keep content visible if reduced motion is preferred */
@media (prefers-reduced-motion: reduce) {
  .fade-in-section {
    opacity: 1;
    transform: none;
    transition: none;
  }
}

/* Project technology tags */
.project-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 18px;
}

.project-tech span {
  display: inline-block;
  padding: 6px 10px;
  border: 1px solid rgba(167, 139, 250, 0.25);
  border-radius: 6px;
  background: rgba(139, 92, 246, 0.08);
  color: #c4b5fd;
  font-size: 12px;
  line-height: 1.5;
  transition:
    background-color 0.3s ease,
    border-color 0.3s ease,
    transform 0.3s ease;
}

.project-tech span:hover {
  background: rgba(139, 92, 246, 0.18);
  border-color: #a78bfa;
  transform: translateY(-2px);
}

/* Keep project cards consistent */
.project-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.project-card .project-link {
  margin-top: 18px;
}

.project-card .project-tech {
  margin-top: auto;
  padding-top: 18px;
}

/* AI Chatbot */
.chatbot-container {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 1000;
  font-family: inherit;
}

.chatbot-toggle {
  display: block;
  margin-left: auto;
  padding: 14px 20px;
  border: 1px solid #a78bfa;
  border-radius: 30px;
  background: #8b5cf6;
  color: white;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(139, 92, 246, 0.3);
  transition: transform 0.2s ease, background 0.2s ease;
}

.chatbot-toggle:hover {
  background: #7c3aed;
  transform: translateY(-3px);
}

.chatbot-window {
  display: flex;
  flex-direction: column;
  width: 350px;
  height: 440px;
  max-width: calc(100vw - 32px);
  max-height: calc(100dvh - 110px);
  margin-bottom: 14px;
  overflow: hidden;
  border: 1px solid rgba(167, 139, 250, 0.4);
  border-radius: 18px;
  background: #171426;
  color: #f5f3ff;
  box-shadow: 0 15px 50px rgba(0, 0, 0, 0.4);
}

.chatbot-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  background: #241c3b;
  border-bottom: 1px solid rgba(167, 139, 250, 0.2);
}

.chatbot-header strong {
  font-size: 15px;
}

.chatbot-header p {
  margin: 5px 0 0;
  color: #c4b5fd;
  font-size: 12px;
}

.chatbot-close {
  border: none;
  background: transparent;
  color: white;
  font-size: 26px;
  cursor: pointer;
}

.chatbot-messages {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 12px;
  padding: 16px;
  overflow-y: auto;
}

.chat-message {
  max-width: 85%;
  padding: 11px 13px;
  border-radius: 12px;
  font-size: 13px;
  line-height: 1.6;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.chat-message.assistant {
  align-self: flex-start;
  background: #29213f;
  color: #f5f3ff;
  border-bottom-left-radius: 4px;
}

.chat-message.user {
  align-self: flex-end;
  background: #7c3aed;
  color: white;
  border-bottom-right-radius: 4px;
}

.chatbot-form {
  display: flex;
  gap: 8px;
  padding: 12px;
  border-top: 1px solid rgba(167, 139, 250, 0.2);
}

.chatbot-form input {
  min-width: 0;
  flex: 1;
  padding: 11px 12px;
  border: 1px solid #4c4265;
  border-radius: 10px;
  outline: none;
  background: #211b31;
  color: white;
  font-size: 13px;
}

.chatbot-form input:focus {
  border-color: #a78bfa;
}

.chatbot-form button {
  width: 42px;
  border: none;
  border-radius: 10px;
  background: #8b5cf6;
  color: white;
  font-size: 22px;
  cursor: pointer;
}

.chatbot-form button:hover {
  background: #7c3aed;
}

@media (max-width: 480px) {
  .chatbot-container {
    right: 12px;
    bottom: 12px;
  }

  .chatbot-window {
    width: calc(100vw - 24px);
    height: min(440px, calc(100dvh - 90px));
  }
}
